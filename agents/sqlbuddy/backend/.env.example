# Copy this file to .env and add your private Gemini API key.
# Do not commit backend/.env.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
SQLBUDDY_REQUEST_TIMEOUT_SECONDS=120
# Leave disabled for local development. Enable for a public deployment.
SQLBUDDY_REQUIRE_ACCESS_PASSWORD=false
SQLBUDDY_ACCESS_PASSWORD=
